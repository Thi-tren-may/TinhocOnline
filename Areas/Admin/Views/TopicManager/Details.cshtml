@model TinhocOnline.Models.Topic

@{
    ViewData["Title"] = "Chi tiết chủ đề";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="pagetitle">
    <h1>Thông tin chi tiết chủ đề</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Chủ đề</a></li>
            <li class="breadcrumb-item active">Chi tiết</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Thông tin chủ đề</h5>

                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <td class="fw-bold" style="width: 35%;">
                                    <i class="bi bi-hash text-primary"></i> ID:
                                </td>
                                <td>#@Model.TopicId</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">
                                    <i class="bi bi-tag text-primary"></i> Mã chủ đề:
                                </td>
                                <td>
                                    <span class="badge bg-primary fs-6">@Model.TopicCode</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-bold">
                                    <i class="bi bi-bookmark text-primary"></i> Tên chủ đề:
                                </td>
                                <td><strong>@Model.TopicName</strong></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">
                                    <i class="bi bi-text-paragraph text-primary"></i> Mô tả:
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(Model.Description))
                                    {
                                        <p class="mb-0">@Model.Description</p>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa có mô tả</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-bold">
                                    <i class="bi bi-toggle-on text-primary"></i> Trạng thái:
                                </td>
                                <td>
                                    @if (Model.Status == "active")
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i> Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle"></i> Ngừng hoạt động
                                        </span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <hr>

                    <div class="mt-3">
                        <a asp-action="Edit" asp-route-id="@Model.TopicId" class="btn btn-warning">
                            <i class="bi bi-pencil-square"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lại danh sách
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.TopicId" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xóa
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Statistics Card -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Thống kê</h5>
                    
                    <div class="d-flex align-items-center mb-3">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background-color: #4154f1; color: white;">
                            <i class="bi bi-question-circle" style="font-size: 24px;"></i>
                        </div>
                        <div class="ps-3">
                            <h6>Câu hỏi</h6>
                            <span class="text-muted small pt-2 ps-1">Đang cập nhật...</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-3">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background-color: #2eca6a; color: white;">
                            <i class="bi bi-file-earmark-text" style="font-size: 24px;"></i>
                        </div>
                        <div class="ps-3">
                            <h6>Đề thi</h6>
                            <span class="text-muted small pt-2 ps-1">Đang cập nhật...</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Info Card -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Thông tin</h5>
                    <div class="alert alert-info mb-0">
                        <h6><i class="bi bi-info-circle"></i> Chú thích</h6>
                        <p class="small mb-0">
                            Chủ đề <strong>@Model.TopicCode</strong> là một trong 7 chủ đề chuẩn 
                            của chương trình Tin học THPT theo quy định của Bộ Giáo dục.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
