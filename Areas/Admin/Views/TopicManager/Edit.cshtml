@model TinhocOnline.Models.Topic

@{
    ViewData["Title"] = "Chỉnh sửa chủ đề";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="pagetitle">
    <h1>Chỉnh sửa thông tin chủ đề</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Chủ đề</a></li>
            <li class="breadcrumb-item active">Chỉnh sửa</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Cập nhật thông tin</h5>

                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="TopicId" />

                        <div class="mb-3">
                            <label asp-for="TopicName" class="form-label">
                                <i class="bi bi-bookmark"></i> Tên chủ đề <span class="text-danger">*</span>
                            </label>
                            <input asp-for="TopicName" class="form-control" placeholder="Nhập tên chủ đề" autofocus />
                            <span asp-validation-for="TopicName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">
                                <i class="bi bi-text-paragraph"></i> Mô tả
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập mô tả chi tiết về chủ đề"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label">
                                <i class="bi bi-toggle-on"></i> Trạng thái
                            </label>
                            <select asp-for="Status" class="form-select">
                                <option value="active">Hoạt động</option>
                                <option value="inactive">Ngừng hoạt động</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-circle"></i> Cập nhật
                                </button>
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="bi bi-x-circle"></i> Hủy
                                </a>
                                <a asp-action="Details" asp-route-id="@Model.TopicId" class="btn btn-info">
                                    <i class="bi bi-info-circle"></i> Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Thông tin</h5>
                    <div class="alert alert-info">
                        <h6><i class="bi bi-info-circle"></i> Lưu ý</h6>
                        <ul class="mb-0">
                            <li>Cập nhật tên chủ đề để dễ dàng quản lý</li>
                            <li>Mô tả giúp giáo viên hiểu rõ hơn về chủ đề</li>
                            <li>Thay đổi trạng thái sẽ ảnh hưởng đến việc tạo đề thi</li>
                        </ul>
                    </div>

                    <div class="alert alert-warning">
                        <h6><i class="bi bi-exclamation-triangle"></i> Cảnh báo</h6>
                        <p class="mb-0 small">Nếu đặt trạng thái "Ngừng hoạt động", chủ đề này sẽ không hiển thị khi tạo đề thi mới.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>