@model IEnumerable<TinhocOnline.Models.Topic>

@{
    ViewData["Title"] = "Quản lý Chủ đề";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="pagetitle">
    <h1>Quản lý Chủ đề</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active">Danh sách chủ đề</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 mt-3">
                        <h5 class="card-title">Danh sách chủ đề (A-G)</h5>
                        <a asp-action="Create" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> Thêm chủ đề
                        </a>
                    </div>

                    <!-- Alert Info -->
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        <i class="bi bi-info-circle me-1"></i>
                        Hệ thống có 7 chủ đề theo chương trình Tin học phổ thông (A-G).
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>

                    <!-- Table -->
                    <div class="table-responsive">
                        <table class="table table-hover table-striped" id="topicTable">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="text-center" style="width: 8%;">Mã</th>
                                    <th scope="col" style="width: 30%;">Tên chủ đề</th>
                                    <th scope="col" style="width: 40%;">Mô tả</th>
                                    <th scope="col" class="text-center" style="width: 12%;">Trạng thái</th>
                                    <th scope="col" class="text-center" style="width: 10%;">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderBy(t => t.TopicCode))
                                {
                                    <tr>
                                        <td class="text-center">
                                            <span class="badge bg-primary fs-6">@item.TopicCode</span>
                                        </td>
                                        <td>
                                            <strong>@item.TopicName</strong>
                                        </td>
                                        <td>
                                            <span class="text-muted">@(item.Description ?? "Chưa có mô tả")</span>
                                        </td>
                                        <td class="text-center">
                                            @if (item.Status == "active")
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle"></i> Hoạt động
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-x-circle"></i> Ngừng hoạt động
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <a asp-action="Details" asp-route-id="@item.TopicId" 
                                                   class="btn btn-sm btn-info" title="Chi tiết">
                                                    <i class="bi bi-info-circle"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@item.TopicId" 
                                                   class="btn btn-sm btn-warning" title="Chỉnh sửa">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.TopicId" 
                                                   class="btn btn-sm btn-danger" title="Xóa">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!Model.Any())
                    {
                        <div class="alert alert-warning text-center" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> Chưa có chủ đề nào trong hệ thống. Vui lòng thêm mới!
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
