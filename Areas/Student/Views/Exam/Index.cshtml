@model IEnumerable<TinhocOnline.Models.Exam>

@{
    ViewData["Title"] = "Danh sách Đề thi";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<div class="pagetitle">
    <h1>Danh sách Đề thi</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Student" asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active">Đề thi</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mt-3 mb-3">
                        <h5 class="card-title mb-0">Đề thi đã được xuất bản</h5>
                        <a asp-action="CreatePractice" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-1"></i> Tạo đề ôn tập
                        </a>
                    </div>

                    <div class="row">
                        @foreach (var item in Model)
                        {
                            <div class="col-md-6 col-lg-4 mb-3">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h5 class="card-title">@item.ExamName</h5>
                                        <p class="card-text">
                                            <small class="text-muted">
                                                <i class="bi bi-person"></i> @item.Creator?.FullName<br/>
                                                <i class="bi bi-collection"></i> @item.ExamType?.TypeName
                                            </small>
                                        </p>
                                        <ul class="list-unstyled">
                                            <li><i class="bi bi-list-ol"></i> <strong>@item.TotalQuestions</strong> câu</li>
                                            <li><i class="bi bi-clock"></i> <strong>@item.Duration</strong> phút</li>
                                            @if (!string.IsNullOrEmpty(item.GradeLevel))
                                            {
                                                <li><i class="bi bi-mortarboard"></i> Lớp <strong>@item.GradeLevel</strong></li>
                                            }
                                            <li><i class="bi bi-trophy"></i> Điểm đạt: <strong>@item.PassingScore</strong></li>
                                        </ul>
                                    </div>
                                    <div class="card-footer">
                                        <a asp-action="TakeExam" asp-route-id="@item.ExamId" class="btn btn-success btn-sm w-100">
                                            <i class="bi bi-pencil-square"></i> Làm bài
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (!Model.Any())
                    {
                        <div class="alert alert-info text-center">
                            <i class="bi bi-info-circle"></i> Chưa có đề thi nào được xuất bản.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
