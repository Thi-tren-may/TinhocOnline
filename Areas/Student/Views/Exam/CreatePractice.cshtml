@model TinhocOnline.Models.ViewModels.CreateExamViewModel

@{
    ViewData["Title"] = "Tạo Đề ôn tập";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
    var topics = ViewBag.Topics as List<TinhocOnline.Models.Topic>;
}

<div class="pagetitle">
    <h1><i class="bi bi-file-earmark-plus me-2"></i>Tạo Đề Ôn Tập</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Student" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Đề thi</a></li>
            <li class="breadcrumb-item active">Tạo đề ôn tập</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="alert alert-primary d-flex align-items-center" role="alert">
                        <i class="bi bi-lightbulb-fill fs-4 me-3"></i>
                        <div>
                            <strong>Lưu ý:</strong> Đề ôn tập được tạo tự động từ ngân hàng câu hỏi. Bạn có thể làm bài ngay sau khi tạo. Tổng tỷ lệ độ khó phải bằng 100%.
                        </div>
                    </div>

                    <form asp-action="CreatePractice" method="post" id="createExamForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mt-3" role="alert"></div>
                        <input type="hidden" asp-for="CreateMode" id="createModeInput" value="custom" />
                        <input type="hidden" asp-for="CreatedBy" />
                        <input type="hidden" asp-for="Status" value="draft" />
                        <input type="hidden" asp-for="ExamName" value="Đề ôn tập" />

                        <!-- Thông tin cơ bản -->
                        <div class="d-flex align-items-center mb-3 pb-2 border-bottom border-primary border-3">
                            <i class="bi bi-gear-fill fs-4 text-primary me-2"></i>
                            <h5 class="mb-0 fw-bold">Thông tin cơ bản</h5>
                        </div>

                        <div class="row mb-3">
                            <label asp-for="ExamTypeId" class="col-sm-3 col-form-label">Loại đề <span
                                    class="text-danger">*</span></label>
                            <div class="col-sm-9">
                                <select asp-for="ExamTypeId" class="form-select" asp-items="ViewBag.ExamTypes">
                                    <option value="">-- Chọn loại đề --</option>
                                </select>
                                <span asp-validation-for="ExamTypeId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label asp-for="GradeLevel" class="col-sm-3 col-form-label">Lớp</label>
                            <div class="col-sm-9">
                                <select asp-for="GradeLevel" class="form-select">
                                    <option value="">-- Tất cả lớp --</option>
                                    <option value="10">Lớp 10</option>
                                    <option value="11">Lớp 11</option>
                                    <option value="12">Lớp 12</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label asp-for="TotalQuestions" class="col-sm-3 col-form-label">Số câu hỏi <span
                                    class="text-danger">*</span></label>
                            <div class="col-sm-9">
                                <input asp-for="TotalQuestions" class="form-control" type="number" />
                                <span asp-validation-for="TotalQuestions" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label asp-for="Duration" class="col-sm-3 col-form-label">Thời gian (phút) <span
                                    class="text-danger">*</span></label>
                            <div class="col-sm-9">
                                <input asp-for="Duration" class="form-control" type="number" />
                                <span asp-validation-for="Duration" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Chọn Chủ đề -->
                        <div class="d-flex align-items-center mb-3 pb-2 border-bottom border-primary border-3 mt-4">
                            <i class="bi bi-collection-fill fs-4 text-primary me-2"></i>
                            <h5 class="mb-0 fw-bold">Chọn Chủ Đề</h5>
                        </div>

                        @if (topics != null)
                        {
                            <div class="row mb-3">
                                <div class="col-sm-12">
                                    @foreach (var topic in topics)
                                    {
                                        <div class="bg-light p-3 rounded mb-2 border border-1">
                                            <div class="form-check">
                                                <input type="checkbox" name="SelectedTopicIds" value="@topic.TopicId"
                                                    class="form-check-input" id="topic@(topic.TopicId)" checked />
                                                <label class="form-check-label fw-semibold" for="topic@(topic.TopicId)">
                                                    @topic.TopicName
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="alert alert-info d-flex align-items-center">
                                <i class="bi bi-info-circle me-2"></i>
                                <small class="mb-0">Các chủ đề được chọn sẽ được phân bổ đều số lượng câu hỏi (mặc định là tất cả)</small>
                            </div>
                        }

                        <!-- Độ khó -->
                        <div class="d-flex align-items-center mb-3 pb-2 border-bottom border-primary border-3 mt-4">
                            <i class="bi bi-sliders fs-4 text-primary me-2"></i>
                            <h5 class="mb-0 fw-bold">Cấu Hình Độ Khó</h5>
                        </div>

                        <div class="bg-light p-4 rounded">
                            <div class="card mb-3 border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <label class="col-sm-3 col-form-label fw-bold">
                                            <i class="bi bi-emoji-smile text-success me-2"></i>Dễ (%) <span class="text-danger">*</span>
                                        </label>
                                        <div class="col-sm-9">
                                            <input asp-for="EasyPercentage" class="form-control" type="number" step="5" />
                                            <span asp-validation-for="EasyPercentage" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card mb-3 border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <label class="col-sm-3 col-form-label fw-bold">
                                            <i class="bi bi-emoji-neutral text-warning me-2"></i>Trung bình (%) <span class="text-danger">*</span>
                                        </label>
                                        <div class="col-sm-9">
                                            <input asp-for="MediumPercentage" class="form-control" type="number" step="5" />
                                            <span asp-validation-for="MediumPercentage" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card mb-3 border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <label class="col-sm-3 col-form-label fw-bold">
                                            <i class="bi bi-emoji-frown text-danger me-2"></i>Khó (%) <span class="text-danger">*</span>
                                        </label>
                                        <div class="col-sm-9">
                                            <input asp-for="HardPercentage" class="form-control" type="number" step="5" />
                                            <span asp-validation-for="HardPercentage" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="text-center p-3 bg-white rounded border border-primary border-2">
                                <strong class="fs-5">Tổng độ khó: <span id="totalDifficulty" class="text-primary">100</span>%</strong>
                            </div>
                        </div>

                        <div class="row mb-3 mt-4">
                            <div class="col-sm-12 text-center">
                                <button type="submit" class="btn btn-primary btn-lg px-5">
                                    <i class="bi bi-play-circle me-2"></i> Tạo đề và Làm bài
                                </button>
                                <a asp-action="Index" class="btn btn-secondary btn-lg px-5 ms-2">
                                    <i class="bi bi-x-circle me-2"></i> Hủy
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Calculate totals
            const easyInput = document.querySelector('input[name="EasyPercentage"]');
            const mediumInput = document.querySelector('input[name="MediumPercentage"]');
            const hardInput = document.querySelector('input[name="HardPercentage"]');
            const totalDifficultySpan = document.getElementById('totalDifficulty');

            function updateTotalDifficulty() {
                if (!easyInput || !mediumInput || !hardInput) return;
                const total = (parseFloat(easyInput.value) || 0) + (parseFloat(mediumInput.value) || 0) + (parseFloat(hardInput.value) || 0);
                totalDifficultySpan.textContent = total.toFixed(2);
                totalDifficultySpan.classList.toggle('text-danger', total !== 100);
            }

            if (easyInput) easyInput.addEventListener('input', updateTotalDifficulty);
            if (mediumInput) mediumInput.addEventListener('input', updateTotalDifficulty);
            if (hardInput) hardInput.addEventListener('input', updateTotalDifficulty);
        });
    </script>
}