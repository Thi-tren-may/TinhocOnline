@model TinhocOnline.Models.ViewModels.CreateExamViewModel

@{
    ViewData["Title"] = "Tạo Đề ôn tập";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
    var topics = ViewBag.Topics as List<TinhocOnline.Models.Topic>;
}

<div class="pagetitle">
    <h1>Tạo Đề ôn tập</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Student" asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Đề thi</a></li>
            <li class="breadcrumb-item active">Tạo đề ôn tập</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-10">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Cấu hình đề ôn tập</h5>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> 
                        <strong>Lưu ý:</strong> Đề ôn tập được tạo tự động từ ngân hàng câu hỏi. Bạn có thể làm bài ngay sau khi tạo.
                    </div>

                    <!-- Tabs -->
                    <ul class="nav nav-tabs" id="createModeTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="quick-tab" data-bs-toggle="tab" data-bs-target="#quick-mode" 
                                    type="button" role="tab">
                                <i class="bi bi-lightning-fill"></i> Tạo nhanh
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="custom-tab" data-bs-toggle="tab" data-bs-target="#custom-mode" 
                                    type="button" role="tab">
                                <i class="bi bi-gear-fill"></i> Tùy chỉnh
                            </button>
                        </li>
                    </ul>

                    <form asp-action="CreatePractice" method="post" id="createExamForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mt-3" role="alert"></div>
                        <input type="hidden" asp-for="CreateMode" id="createModeInput" value="quick" />
                        <input type="hidden" asp-for="CreatedBy" />
                        <input type="hidden" asp-for="Status" value="draft" />
                        <input type="hidden" asp-for="ExamName" value="Đề ôn tập" />

                        <!-- Chọn Chủ đề (áp dụng cho cả 2 chế độ) -->
                        <div class="mt-3">
                            <h6><i class="bi bi-collection"></i> Chọn Chủ đề</h6>
                            @if (topics != null)
                            {
                                <div class="row mb-3">
                                    <div class="col-sm-12">
                                        @foreach (var topic in topics)
                                        {
                                            <div class="form-check mb-2">
                                                <input type="checkbox" name="SelectedTopicIds" value="@topic.TopicId" 
                                                       class="form-check-input" id="topic@(topic.TopicId)" checked />
                                                <label class="form-check-label" for="topic@(topic.TopicId)">
                                                    @topic.TopicName
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="alert alert-info">
                                    <small><i class="bi bi-info-circle"></i> Các chủ đề được chọn sẽ được phân bổ đều số lượng câu hỏi (mặc định là tất cả)</small>
                                </div>
                            }
                        </div>

                        <div class="tab-content mt-3" id="createModeTabContent">
                            <!-- Tab Tạo nhanh -->
                            <div class="tab-pane fade show active" id="quick-mode" role="tabpanel">
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle"></i> 
                                    <strong>Tạo nhanh:</strong> Hệ thống tự động phân bổ câu hỏi đều theo 7 chủ đề với tỷ lệ (40% Dễ, 30% TB, 30% Khó).
                                </div>

                                <div class="row mb-3">
                                    <label asp-for="ExamTypeId" class="col-sm-3 col-form-label">Loại đề <span class="text-danger">*</span></label>
                                    <div class="col-sm-9">
                                        <select asp-for="ExamTypeId" class="form-select" asp-items="ViewBag.ExamTypes">
                                            <option value="">-- Chọn loại đề --</option>
                                        </select>
                                        <span asp-validation-for="ExamTypeId" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label asp-for="GradeLevel" class="col-sm-3 col-form-label">Lớp</label>
                                    <div class="col-sm-9">
                                        <select asp-for="GradeLevel" class="form-select">
                                            <option value="">-- Tất cả lớp --</option>
                                            <option value="10">Lớp 10</option>
                                            <option value="11">Lớp 11</option>
                                            <option value="12">Lớp 12</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label asp-for="TotalQuestions" class="col-sm-3 col-form-label">Số câu hỏi</label>
                                    <div class="col-sm-9">
                                        <input asp-for="TotalQuestions" class="form-control" type="number" />
                                        <span asp-validation-for="TotalQuestions" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label asp-for="Duration" class="col-sm-3 col-form-label">Thời gian (phút)</label>
                                    <div class="col-sm-9">
                                        <input asp-for="Duration" class="form-control" type="number" />
                                        <span asp-validation-for="Duration" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Tab Tùy chỉnh -->
                            <div class="tab-pane fade" id="custom-mode" role="tabpanel">
                                <div class="alert alert-warning">
                                    <i class="bi bi-exclamation-triangle"></i> 
                                    <strong>Tùy chỉnh:</strong> Tự cấu hình chủ đề và độ khó. Tổng tỷ lệ = 100%.
                                </div>

                                <div class="row mb-3">
                                    <label asp-for="ExamTypeId" class="col-sm-3 col-form-label">Loại đề <span class="text-danger">*</span></label>
                                    <div class="col-sm-9">
                                        <select asp-for="ExamTypeId" class="form-select" asp-items="ViewBag.ExamTypes">
                                            <option value="">-- Chọn loại đề --</option>
                                        </select>
                                        <span asp-validation-for="ExamTypeId" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label asp-for="GradeLevel" class="col-sm-3 col-form-label">Lớp</label>
                                    <div class="col-sm-9">
                                        <select asp-for="GradeLevel" class="form-select">
                                            <option value="">-- Tất cả lớp --</option>
                                            <option value="10">Lớp 10</option>
                                            <option value="11">Lớp 11</option>
                                            <option value="12">Lớp 12</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label asp-for="TotalQuestions" class="col-sm-3 col-form-label">Số câu hỏi</label>
                                    <div class="col-sm-9">
                                        <input asp-for="TotalQuestions" class="form-control" type="number" />
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label asp-for="Duration" class="col-sm-3 col-form-label">Thời gian (phút)</label>
                                    <div class="col-sm-9">
                                        <input asp-for="Duration" class="form-control" type="number" />
                                    </div>
                                </div>

                                <hr class="my-3">
                                <h6><i class="bi bi-sliders"></i> Độ khó</h6>

                                <div class="row mb-3">
                                    <label class="col-sm-3 col-form-label">Dễ (%)</label>
                                    <div class="col-sm-9">
                                        <input asp-for="EasyPercentage" class="form-control" type="number" step="0.01" />
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label class="col-sm-3 col-form-label">Trung bình (%)</label>
                                    <div class="col-sm-9">
                                        <input asp-for="MediumPercentage" class="form-control" type="number" step="0.01" />
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label class="col-sm-3 col-form-label">Khó (%)</label>
                                    <div class="col-sm-9">
                                        <input asp-for="HardPercentage" class="form-control" type="number" step="0.01" />
                                        <small>Tổng = <span id="totalDifficulty">100</span>%</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-9 offset-sm-3">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-play-circle me-1"></i> Tạo đề và Làm bài
                                </button>
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="bi bi-x-circle me-1"></i> Hủy
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const quickTab = document.getElementById('quick-tab');
            const customTab = document.getElementById('custom-tab');
            const createModeInput = document.getElementById('createModeInput');

            quickTab.addEventListener('click', function() {
                createModeInput.value = 'quick';
            });

            customTab.addEventListener('click', function() {
                createModeInput.value = 'custom';
            });

            // Calculate totals
            const easyInput = document.querySelector('input[name="EasyPercentage"]');
            const mediumInput = document.querySelector('input[name="MediumPercentage"]');
            const hardInput = document.querySelector('input[name="HardPercentage"]');
            const totalDifficultySpan = document.getElementById('totalDifficulty');

            function updateTotalDifficulty() {
                if (!easyInput || !mediumInput || !hardInput) return;
                const total = (parseFloat(easyInput.value) || 0) + (parseFloat(mediumInput.value) || 0) + (parseFloat(hardInput.value) || 0);
                totalDifficultySpan.textContent = total.toFixed(2);
                totalDifficultySpan.classList.toggle('text-danger', total !== 100);
            }

            if (easyInput) easyInput.addEventListener('input', updateTotalDifficulty);
            if (mediumInput) mediumInput.addEventListener('input', updateTotalDifficulty);
            if (hardInput) hardInput.addEventListener('input', updateTotalDifficulty);
        });
    </script>
}
