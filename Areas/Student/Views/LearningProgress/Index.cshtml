@model TinhocOnline.Areas.Student.ViewModels.ReviewIndexViewModel

@{
    ViewData["Title"] = "Quá trình học tập";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<!-- Header Start -->
<div class="container-fluid bg-breadcrumb">
    <div class="container text-center py-5" style="max-width: 900px;">
        <h3 class="text-white display-3 mb-4 wow fadeInDown" data-wow-delay="0.1s">Quá trình học tập</h3>
        <ol class="breadcrumb justify-content-center text-white mb-0 wow fadeInDown" data-wow-delay="0.3s">
            <li class="breadcrumb-item"><a asp-area="Student" asp-controller="Home" asp-action="Index" class="text-white">Trang chủ</a></li>
            <li class="breadcrumb-item active text-secondary">Quá trình học tập</li>
        </ol>
    </div>
</div>
<!-- Header End -->

<!-- Learning Progress Content Start -->
<div class="container-fluid service py-5">
    <div class="container py-5">
        
        @if (Model.Progress.TotalExamsTaken > 0)
        {
            <!-- Progress Statistics -->
            <div class="text-center mx-auto pb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 1000px;">
                <h1 class="display-5 text-capitalize mb-4">Thống kê tổng quan</h1>
                
                <div class="row g-4">
                    <div class="col-lg-3 col-md-6">
                        <div class="counter-item bg-light p-4 rounded-3 shadow-sm">
                            <div class="counter-icon mb-3">
                                <i class="fas fa-clipboard-list text-primary"></i>
                            </div>
                            <h2 class="text-primary mb-2">@Model.Progress.TotalExamsTaken</h2>
                            <p class="mb-0 text-muted">Bài thi hoàn thành</p>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="counter-item bg-light p-4 rounded-3 shadow-sm">
                            <div class="counter-icon mb-3">
                                <i class="fas fa-question-circle text-success"></i>
                            </div>
                            <h2 class="text-success mb-2">@Model.Progress.TotalQuestionsAnswered</h2>
                            <p class="mb-0 text-muted">Câu hỏi đã trả lời</p>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="counter-item bg-light p-4 rounded-3 shadow-sm">
                            <div class="counter-icon mb-3">
                                <i class="fas fa-check-double text-info"></i>
                            </div>
                            <h2 class="text-info mb-2">@Model.Progress.TotalCorrectAnswers</h2>
                            <p class="mb-0 text-muted">Câu trả lời đúng</p>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="counter-item bg-light p-4 rounded-3 shadow-sm">
                            <div class="counter-icon mb-3">
                                <i class="fas fa-percentage text-warning"></i>
                            </div>
                            <h2 class="text-warning mb-2">@Model.Progress.AverageAccuracy.ToString("0.0")%</h2>
                            <p class="mb-0 text-muted">Độ chính xác trung bình</p>
                        </div>
                    </div>
                </div>

                @if (Model.Progress.LastExamDate.HasValue)
                {
                    <div class="alert alert-info mt-4">
                        <i class="fas fa-calendar-check me-2"></i>
                        Bài thi gần nhất: <strong>@Model.Progress.LastExamDate.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                }
            </div>

            <!-- AI Assessment -->
            @if (Model.Assessment != null)
            {
                <div class="row g-4 mb-5">
                    <div class="col-12">
                        <div class="text-center mx-auto pb-4 wow fadeInUp" data-wow-delay="0.1s">
                            <h2 class="display-6 mb-3">
                                <i class="fas fa-brain text-primary me-2"></i>
                                Đánh giá từ AI
                            </h2>
                            <p class="text-muted">Phân tích chi tiết quá trình học tập của bạn</p>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <div class="card h-100 border-primary shadow">
                                    <div class="card-body text-center">
                                        <i class="fas fa-chart-line fa-3x text-primary mb-3"></i>
                                        <h5 class="card-title text-primary">Xu hướng tiến bộ</h5>
                                        <p class="card-text">@Model.Assessment.Trend</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card h-100 border-success shadow">
                                    <div class="card-body text-center">
                                        <i class="fas fa-star fa-3x text-success mb-3"></i>
                                        <h5 class="card-title text-success">Điểm mạnh</h5>
                                        <p class="card-text">@Model.Assessment.Strengths</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card h-100 border-warning shadow">
                                    <div class="card-body text-center">
                                        <i class="fas fa-exclamation-circle fa-3x text-warning mb-3"></i>
                                        <h5 class="card-title text-warning">Cần cải thiện</h5>
                                        <p class="card-text">@Model.Assessment.Weaknesses</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (Model.Assessment.Recommendations.Any())
                        {
                            <div class="card border-info shadow">
                                <div class="card-header bg-info text-white">
                                    <h5 class="mb-0">
                                        <i class="fas fa-lightbulb me-2"></i>Lời khuyên từ AI
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <ol class="mb-0">
                                        @foreach (var recommendation in Model.Assessment.Recommendations)
                                        {
                                            <li class="mb-3">
                                                <i class="fas fa-arrow-right text-info me-2"></i>@recommendation
                                            </li>
                                        }
                                    </ol>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Topic Performance -->
            @if (Model.RecommendedTopics.Any())
            {
                <div class="row g-4 mb-5">
                    <div class="col-12">
                        <div class="text-center mx-auto pb-4 wow fadeInUp" data-wow-delay="0.1s">
                            <h2 class="display-6 mb-3">
                                <i class="fas fa-book-reader text-warning me-2"></i>
                                Hiệu suất theo chủ đề
                            </h2>
                            <p class="text-muted">Các chủ đề bạn đã học và mức độ nắm vững</p>
                        </div>

                        <div class="card shadow-sm">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>STT</th>
                                                <th>Chủ đề</th>
                                                <th class="text-center">Số lần làm</th>
                                                <th class="text-center">Tổng câu</th>
                                                <th class="text-center">Đúng</th>
                                                <th class="text-center">Sai</th>
                                                <th class="text-center">Độ chính xác</th>
                                                <th class="text-center">Mức độ</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < Model.RecommendedTopics.Count; i++)
                                            {
                                                var topic = Model.RecommendedTopics[i];
                                                var priorityClass = topic.Priority == "High" ? "danger" : topic.Priority == "Medium" ? "warning" : "success";
                                                var priorityText = topic.Priority == "High" ? "Cần ôn" : topic.Priority == "Medium" ? "Khá" : "Tốt";
                                                var wrongAnswers = topic.TotalQuestions - topic.TotalAttempts * topic.TotalQuestions;
                                                var correctAnswers = (int)(topic.TotalQuestions * topic.AccuracyPercentage / 100);
                                                var wrong = topic.TotalQuestions - correctAnswers;
                                                
                                                <tr>
                                                    <td>@(i + 1)</td>
                                                    <td>
                                                        <strong>@topic.TopicName</strong>
                                                    </td>
                                                    <td class="text-center">
                                                        @if (topic.TotalAttempts > 0)
                                                        {
                                                            <span class="badge bg-info">@topic.TotalAttempts</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        @if (topic.TotalQuestions > 0)
                                                        {
                                                            <strong>@topic.TotalQuestions</strong>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">0</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        @if (topic.TotalAttempts > 0)
                                                        {
                                                            <span class="text-success"><strong>@correctAnswers</strong></span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        @if (topic.TotalAttempts > 0)
                                                        {
                                                            <span class="text-danger"><strong>@wrong</strong></span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        @if (topic.TotalAttempts > 0)
                                                        {
                                                            <div class="d-flex align-items-center justify-content-center">
                                                                <span class="ms-2 fw-bold text-@priorityClass">@topic.AccuracyPercentage.ToString("0.0")%</span>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        @if (topic.TotalAttempts > 0)
                                                        {
                                                            <span class="badge bg-@priorityClass">@priorityText</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">Chưa làm</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Recent Exams -->
            @if (Model.RecentAnalyses.Any())
            {
                <div class="row g-4">
                    <div class="col-12">
                        <div class="text-center mx-auto pb-4 wow fadeInUp" data-wow-delay="0.1s">
                            <h2 class="display-6 mb-3">
                                <i class="fas fa-history text-secondary me-2"></i>
                                Lịch sử bài thi gần đây
                            </h2>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-primary">
                                    <tr>
                                        <th>STT</th>
                                        <th>Tên bài thi</th>
                                        <th>Ngày làm</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.RecentAnalyses.Count; i++)
                                    {
                                        var exam = Model.RecentAnalyses[i];
                                        var badgeClass = exam.AccuracyPercentage >= 80 ? "success" : exam.AccuracyPercentage >= 50 ? "warning" : "danger";
                                        
                                        <tr>
                                            <td>@(i + 1)</td>
                                            <td><strong>@exam.ExamName</strong></td>
                                            <td>@exam.AnalyzedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <a asp-area="Student" asp-controller="Exam" asp-action="ViewResults" 
                                                   asp-route-id="@exam.StudentExamId" 
                                                   class="btn btn-sm btn-primary">
                                                    <i class="fas fa-eye me-1"></i>Chi tiết
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- No Data -->
            <div class="text-center py-5 wow fadeInUp" data-wow-delay="0.1s">
                <i class="fas fa-inbox fa-5x text-muted mb-4"></i>
                <h3 class="mb-3">Chưa có dữ liệu quá trình học tập</h3>
                <p class="text-muted mb-4">Bạn chưa hoàn thành bài thi nào. Hãy bắt đầu làm bài để xem quá trình học tập của mình!</p>
                <a asp-area="Student" asp-controller="Exam" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5">
                    <i class="fas fa-play-circle me-2"></i>Bắt đầu làm bài
                </a>
            </div>
        }
    </div>
</div>
<!-- Learning Progress Content End -->
