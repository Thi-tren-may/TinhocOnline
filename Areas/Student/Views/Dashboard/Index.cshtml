@{
    ViewData["Title"] = "Dashboard - Học Sinh";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<!-- Page Header với Gradient -->
<div class="page-header">
    <h1>
        <i class="bi bi-speedometer2 me-2"></i>Dashboard
    </h1>
    <p class="page-description">Tổng quan về tiến trình học tập và kết quả của bạn</p>
</div>

<!-- Statistics Cards -->
<div class="row g-3 mb-4">
    <!-- Card 1: Bài thi khả dụng -->
    <div class="col-xl-3 col-md-6">
        <div class="stats-card stats-card-primary">
            <div class="stats-card-icon">
                <i class="bi bi-file-earmark-text-fill"></i>
            </div>
            <div class="stats-card-content">
                <div class="stats-card-title">Bài thi khả dụng</div>
                <div class="stats-card-value">5</div>
                <div class="stats-card-subtitle">
                    <i class="bi bi-arrow-up-circle-fill text-success me-1"></i>
                    2 bài mới hôm nay
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Điểm trung bình -->
    <div class="col-xl-4 col-md-6">
        <div class="stats-card stats-card-warning">
            <div class="stats-card-icon">
                <i class="bi bi-star-fill"></i>
            </div>
            <div class="stats-card-content">
                <div class="stats-card-title">Điểm trung bình</div>
                <div class="stats-card-value">8.5</div>
                <div class="stats-card-subtitle">
                    <i class="bi bi-graph-up me-1"></i>
                    +0.5 so với tháng trước
                </div>
            </div>
        </div>
    </div>

    <!-- Card 4: Xếp hạng -->
    <div class="col-xl-3 col-md-6">
        <div class="stats-card stats-card-info">
            <div class="stats-card-icon">
                <i class="bi bi-trophy-fill"></i>
            </div>
            <div class="stats-card-content">
                <div class="stats-card-title">Xếp hạng</div>
                <div class="stats-card-value">#15</div>
                <div class="stats-card-subtitle">
                    <i class="bi bi-people-fill me-1"></i>
                    Trong 150 học sinh
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Lịch sử thi & Biểu đồ -->
    <div class="col-lg-8">
        <!-- Lịch sử thi gần đây -->
        <div class="card-modern mb-4 p-4">
            <div class="card-modern-header">
                <h3 class="card-modern-title">
                    <i class="bi bi-clock-history me-2"></i>Lịch sử thi gần đây
                </h3>
                <a href="#" class="btn btn-sm btn-student-primary">
                    Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="card-modern-body">
                <div class="table-responsive">
                    <table class="table exam-history-table">
                        <thead>
                            <tr>
                                <th>Tên bài thi</th>
                                <th>Môn học</th>
                                <th class="text-center">Số câu</th>
                                <th class="text-center">Thời gian</th>
                                <th class="text-center">Điểm</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="exam-info">
                                        <i class="bi bi-file-text text-primary me-2"></i>
                                        <strong>Kiểm tra giữa kỳ - Tin học</strong>
                                    </div>
                                </td>
                                <td><span class="badge bg-primary">Tin học cơ bản</span></td>
                                <td class="text-center">25</td>
                                <td class="text-center">60 phút</td>
                                <td class="text-center">
                                    <span class="score-badge score-excellent">9.2</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-success-outline">
                                        <i class="bi bi-check-circle me-1"></i>Đã hoàn thành
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-student-primary">
                                        <i class="bi bi-eye"></i> Xem
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="exam-info">
                                        <i class="bi bi-file-text text-success me-2"></i>
                                        <strong>Bài tập tuần 5 - C++</strong>
                                    </div>
                                </td>
                                <td><span class="badge bg-success">Lập trình C++</span></td>
                                <td class="text-center">20</td>
                                <td class="text-center">45 phút</td>
                                <td class="text-center">
                                    <span class="score-badge score-good">8.0</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-success-outline">
                                        <i class="bi bi-check-circle me-1"></i>Đã hoàn thành
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-student-primary">
                                        <i class="bi bi-eye"></i> Xem
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="exam-info">
                                        <i class="bi bi-file-text text-info me-2"></i>
                                        <strong>Kiểm tra định kỳ - CTDL</strong>
                                    </div>
                                </td>
                                <td><span class="badge bg-info">Cấu trúc dữ liệu</span></td>
                                <td class="text-center">30</td>
                                <td class="text-center">90 phút</td>
                                <td class="text-center">
                                    <span class="score-badge score-average">7.5</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-success-outline">
                                        <i class="bi bi-check-circle me-1"></i>Đã hoàn thành
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-student-primary">
                                        <i class="bi bi-eye"></i> Xem
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Biểu đồ tiến trình -->
        <div class="card-modern p-4">
            <div class="card-modern-header">
                <h3 class="card-modern-title">
                    <i class="bi bi-graph-up me-2"></i>Tiến trình học tập
                </h3>
                <select class="form-select form-select-sm" style="width: auto;">
                    <option>7 ngày qua</option>
                    <option>30 ngày qua</option>
                    <option>3 tháng qua</option>
                </select>
            </div>
            <div class="card-modern-body">
                <div class="chart-placeholder">
                    <i class="bi bi-bar-chart-line"
                        style="font-size: 3rem; color: var(--primary-color); opacity: 0.3;"></i>
                    <p class="text-muted mt-3">Biểu đồ điểm số theo thời gian</p>
                    <small class="text-muted">(Tích hợp Chart.js để hiển thị biểu đồ)</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Hoạt động & Sắp tới -->
    <div class="col-lg-4">
        <!-- Hoạt động gần đây -->
        <div class="card-modern mb-4 p-4">
            <div class="card-modern-header">
                <h3 class="card-modern-title">
                    <i class="bi bi-activity me-2"></i>Hoạt động gần đây
                </h3>
            </div>
            <div class="card-modern-body">
                <div class="activity-timeline">
                    <div class="activity-item">
                        <div class="activity-icon bg-success">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                        <div class="activity-content">
                            <div class="activity-title">Hoàn thành bài thi</div>
                            <div class="activity-description">Kiểm tra giữa kỳ - Tin học</div>
                            <div class="activity-time">
                                <i class="bi bi-clock me-1"></i>32 phút trước
                            </div>
                        </div>
                    </div>

                    <div class="activity-item">
                        <div class="activity-icon bg-warning">
                            <i class="bi bi-pencil-fill"></i>
                        </div>
                        <div class="activity-content">
                            <div class="activity-title">Bắt đầu làm bài</div>
                            <div class="activity-description">Bài tập tuần 5 - C++</div>
                            <div class="activity-time">
                                <i class="bi bi-clock me-1"></i>1 giờ trước
                            </div>
                        </div>
                    </div>

                    <div class="activity-item">
                        <div class="activity-icon bg-primary">
                            <i class="bi bi-eye-fill"></i>
                        </div>
                        <div class="activity-content">
                            <div class="activity-title">Xem lại kết quả</div>
                            <div class="activity-description">Kiểm tra định kỳ - CTDL</div>
                            <div class="activity-time">
                                <i class="bi bi-clock me-1"></i>2 giờ trước
                            </div>
                        </div>
                    </div>

                    <div class="activity-item">
                        <div class="activity-icon bg-info">
                            <i class="bi bi-upload"></i>
                        </div>
                        <div class="activity-content">
                            <div class="activity-title">Nộp bài tập</div>
                            <div class="activity-description">Bài tập về nhà - Tuần 4</div>
                            <div class="activity-time">
                                <i class="bi bi-clock me-1"></i>1 ngày trước
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bài thi sắp tới -->
        <div class="card-modern p-4">
            <div class="card-modern-header">
                <h3 class="card-modern-title">
                    <i class="bi bi-calendar-event me-2"></i>Bài thi sắp tới
                </h3>
            </div>
            <div class="card-modern-body">
                <div class="upcoming-exam-item">
                    <div class="upcoming-exam-icon">
                        <i class="bi bi-file-earmark-text-fill"></i>
                    </div>
                    <div class="upcoming-exam-content">
                        <div class="upcoming-exam-title">Kiểm tra cuối kỳ</div>
                        <div class="upcoming-exam-subject">
                            <i class="bi bi-book me-1"></i>Tin học cơ bản
                        </div>
                        <div class="upcoming-exam-meta">
                            <span class="badge badge-danger-outline">
                                <i class="bi bi-exclamation-circle me-1"></i>Bắt buộc
                            </span>
                            <span class="text-muted ms-2">
                                <i class="bi bi-clock me-1"></i>120 phút
                            </span>
                        </div>
                    </div>
                </div>

                <div class="upcoming-exam-item">
                    <div class="upcoming-exam-icon">
                        <i class="bi bi-file-earmark-text-fill"></i>
                    </div>
                    <div class="upcoming-exam-content">
                        <div class="upcoming-exam-title">Bài tập lớn</div>
                        <div class="upcoming-exam-subject">
                            <i class="bi bi-book me-1"></i>Lập trình C++
                        </div>
                        <div class="upcoming-exam-meta">
                            <span class="badge badge-info-outline">
                                <i class="bi bi-pencil me-1"></i>Tự chọn
                            </span>
                            <span class="text-muted ms-2">
                                <i class="bi bi-clock me-1"></i>180 phút
                            </span>
                        </div>
                    </div>
                </div>

                <div class="upcoming-exam-item">
                    <div class="upcoming-exam-icon">
                        <i class="bi bi-file-earmark-text-fill"></i>
                    </div>
                    <div class="upcoming-exam-content">
                        <div class="upcoming-exam-title">Thực hành số 3</div>
                        <div class="upcoming-exam-subject">
                            <i class="bi bi-book me-1"></i>Cấu trúc dữ liệu
                        </div>
                        <div class="upcoming-exam-meta">
                            <span class="badge badge-info-outline">
                                <i class="bi bi-pencil me-1"></i>Tự chọn
                            </span>
                            <span class="text-muted ms-2">
                                <i class="bi bi-clock me-1"></i>90 phút
                            </span>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-3">
                    <a asp-area="Student" asp-controller="Exam" asp-action="Index"
                        class="btn btn-student-primary w-100">
                        <i class="bi bi-list-ul me-2"></i>Xem tất cả bài thi
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Stats Cards */
        .stats-card {
            background: white;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 2px 8px rgba(0, 82, 162, 0.08);
            border: 1px solid rgba(0, 82, 162, 0.1);
            display: flex;
            align-items: center;
            gap: 20px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .stats-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, var(--primary-color) 0%, var(--primary-light) 100%);
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .stats-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0, 82, 162, 0.15);
        }

        .stats-card:hover::before {
            width: 100%;
        }

        .stats-card-icon {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            flex-shrink: 0;
            position: relative;
            z-index: 1;
        }

        .stats-card-primary .stats-card-icon {
            background: linear-gradient(135deg, #0052A2 0%, #66CCFF 100%);
            color: white;
        }

        .stats-card-success .stats-card-icon {
            background: linear-gradient(135deg, #28A745 0%, #7FD893 100%);
            color: white;
        }

        .stats-card-warning .stats-card-icon {
            background: linear-gradient(135deg, #FFC107 0%, #FFE082 100%);
            color: white;
        }

        .stats-card-info .stats-card-icon {
            background: linear-gradient(135deg, #17A2B8 0%, #7DD3DE 100%);
            color: white;
        }

        .stats-card-content {
            flex: 1;
            position: relative;
            z-index: 1;
        }

        .stats-card-title {
            font-size: 14px;
            color: #6c757d;
            margin-bottom: 8px;
            font-weight: 500;
        }

        .stats-card-value {
            font-size: 32px;
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 4px;
            line-height: 1;
        }

        .stats-card-subtitle {
            font-size: 13px;
            color: #6c757d;
            display: flex;
            align-items: center;
        }

        /* Exam History Table */
        .exam-history-table {
            margin-bottom: 0;
        }

        .exam-history-table thead th {
            background: linear-gradient(135deg, rgba(0, 82, 162, 0.05) 0%, rgba(102, 204, 255, 0.05) 100%);
            color: var(--primary-color);
            font-weight: 600;
            border: none;
            padding: 16px 12px;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .exam-history-table tbody tr {
            border-bottom: 1px solid rgba(0, 82, 162, 0.08);
            transition: all 0.2s ease;
        }

        .exam-history-table tbody tr:hover {
            background: rgba(0, 82, 162, 0.03);
            transform: scale(1.01);
        }

        .exam-history-table tbody td {
            padding: 16px 12px;
            vertical-align: middle;
        }

        .exam-info {
            display: flex;
            align-items: center;
        }

        .score-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
        }

        .score-excellent {
            background: linear-gradient(135deg, #28A745 0%, #7FD893 100%);
            color: white;
        }

        .score-good {
            background: linear-gradient(135deg, #17A2B8 0%, #7DD3DE 100%);
            color: white;
        }

        .score-average {
            background: linear-gradient(135deg, #FFC107 0%, #FFE082 100%);
            color: white;
        }

        .badge-success-outline {
            background: rgba(40, 167, 69, 0.1);
            color: #28A745;
            border: 1px solid rgba(40, 167, 69, 0.2);
            padding: 6px 12px;
            border-radius: 8px;
            font-weight: 500;
        }

        /* Chart Placeholder */
        .chart-placeholder {
            height: 300px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, rgba(0, 82, 162, 0.03) 0%, rgba(102, 204, 255, 0.03) 100%);
            border-radius: 12px;
            border: 2px dashed rgba(0, 82, 162, 0.2);
        }

        /* Activity Timeline */
        .activity-timeline {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .activity-item {
            display: flex;
            gap: 16px;
            position: relative;
        }

        .activity-item:not(:last-child)::after {
            content: '';
            position: absolute;
            left: 19px;
            top: 40px;
            width: 2px;
            height: calc(100% + 20px);
            background: linear-gradient(180deg, rgba(0, 82, 162, 0.2) 0%, rgba(102, 204, 255, 0.1) 100%);
        }

        .activity-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            flex-shrink: 0;
            font-size: 18px;
        }

        .activity-content {
            flex: 1;
        }

        .activity-title {
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 4px;
            font-size: 14px;
        }

        .activity-description {
            color: #6c757d;
            font-size: 13px;
            margin-bottom: 4px;
        }

        .activity-time {
            color: #adb5bd;
            font-size: 12px;
        }

        /* Upcoming Exams */
        .upcoming-exam-item {
            display: flex;
            gap: 16px;
            padding: 16px;
            background: linear-gradient(135deg, rgba(0, 82, 162, 0.03) 0%, rgba(102, 204, 255, 0.03) 100%);
            border-radius: 12px;
            margin-bottom: 12px;
            border: 1px solid rgba(0, 82, 162, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .upcoming-exam-item:hover {
            transform: translateX(8px);
            box-shadow: 0 4px 12px rgba(0, 82, 162, 0.1);
        }

        .upcoming-exam-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            flex-shrink: 0;
        }

        .upcoming-exam-content {
            flex: 1;
        }

        .upcoming-exam-title {
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 4px;
            font-size: 15px;
        }

        .upcoming-exam-subject {
            color: #6c757d;
            font-size: 13px;
            margin-bottom: 8px;
        }

        .upcoming-exam-meta {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .badge-danger-outline {
            background: rgba(220, 53, 69, 0.1);
            color: #DC3545;
            border: 1px solid rgba(220, 53, 69, 0.2);
            padding: 4px 10px;
            border-radius: 6px;
            font-weight: 500;
            font-size: 12px;
        }

        .badge-info-outline {
            background: rgba(23, 162, 184, 0.1);
            color: #17A2B8;
            border: 1px solid rgba(23, 162, 184, 0.2);
            padding: 4px 10px;
            border-radius: 6px;
            font-weight: 500;
            font-size: 12px;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .stats-card {
                padding: 20px;
            }

            .stats-card-icon {
                width: 56px;
                height: 56px;
                font-size: 24px;
            }

            .stats-card-value {
                font-size: 28px;
            }

            .exam-history-table {
                font-size: 13px;
            }
        }
    </style>
}