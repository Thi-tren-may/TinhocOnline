@{
    ViewData["Title"] = "Dashboard - Học Sinh";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<div class="pagetitle">
    <h1>Dashboard</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Trang chủ</a></li>
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<section class="section dashboard">
    <div class="row">

        <!-- Left side columns -->
        <div class="col-lg-8">
            <div class="row">

                <!-- Exams Card -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card sales-card">
                        <div class="card-body">
                            <h5 class="card-title">Bài kiểm tra <span>| Khả dụng</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-file-text"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>5</h6>
                                    <span class="text-muted small pt-2 ps-1">bài kiểm tra</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Exams Card -->
                <!-- Completed Exams Card -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card revenue-card">
                        <div class="card-body">
                            <h5 class="card-title">Đã hoàn thành <span>| Tháng này</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-check-circle"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>8</h6>
                                    <span class="text-muted small pt-2 ps-1">bài kiểm tra</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Completed Exams Card -->
                <!-- Average Score Card -->
                <div class="col-xxl-4 col-xl-12">
                    <div class="card info-card customers-card">
                        <div class="card-body">
                            <h5 class="card-title">Điểm trung bình <span>| Tổng quan</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-star"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>8.5</h6>
                                    <span class="text-muted small pt-2 ps-1">điểm</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Average Score Card -->
                <!-- Recent Exams -->
                <div class="col-12">
                    <div class="card recent-sales overflow-auto">
                        <div class="card-body">
                            <h5 class="card-title">Bài kiểm tra gần đây <span>| Hôm nay</span></h5>
                            <table class="table table-borderless">
                                <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">Tên bài kiểm tra</th>
                                        <th scope="col">Môn học</th>
                                        <th scope="col">Thời gian</th>
                                        <th scope="col">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <th scope="row">1</th>
                                        <td>Kiểm tra giữa kỳ</td>
                                        <td>Tin học</td>
                                        <td>60 phút</td>
                                        <td><span class="badge bg-success">Khả dụng</span></td>
                                    </tr>
                                    <tr>
                                        <th scope="row">2</th>
                                        <td>Bài tập tuần 5</td>
                                        <td>Lập trình C++</td>
                                        <td>45 phút</td>
                                        <td><span class="badge bg-warning">Đang làm</span></td>
                                    </tr>
                                    <tr>
                                        <th scope="row">3</th>
                                        <td>Kiểm tra định kỳ</td>
                                        <td>Cấu trúc dữ liệu</td>
                                        <td>90 phút</td>
                                        <td><span class="badge bg-primary">Hoàn thành</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div><!-- End Recent Exams -->

            </div>
        </div><!-- End Left side columns -->
        <!-- Right side columns -->
        <div class="col-lg-4">

            <!-- Recent Activity -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Hoạt động gần đây <span>| Hôm nay</span></h5>
                    <div class="activity">
                        <div class="activity-item d-flex">
                            <div class="activite-label">32 phút</div>
                            <i class='bi bi-circle-fill activity-badge text-success align-self-start'></i>
                            <div class="activity-content">
                                Hoàn thành <a href="#" class="fw-bold text-dark">Bài kiểm tra số 1</a>
                            </div>
                        </div><!-- End activity item-->

                        <div class="activity-item d-flex">
                            <div class="activite-label">56 phút</div>
                            <i class='bi bi-circle-fill activity-badge text-warning align-self-start'></i>
                            <div class="activity-content">
                                Bắt đầu làm <a href="#" class="fw-bold text-dark">Bài tập tuần 5</a>
                            </div>
                        </div><!-- End activity item-->

                        <div class="activity-item d-flex">
                            <div class="activite-label">2 giờ</div>
                            <i class='bi bi-circle-fill activity-badge text-primary align-self-start'></i>
                            <div class="activity-content">
                                Xem lại kết quả <a href="#" class="fw-bold text-dark">Kiểm tra định kỳ</a>
                            </div>
                        </div><!-- End activity item-->

                        <div class="activity-item d-flex">
                            <div class="activite-label">1 ngày</div>
                            <i class='bi bi-circle-fill activity-badge text-info align-self-start'></i>
                            <div class="activity-content">
                                Nộp bài <a href="#" class="fw-bold text-dark">Bài tập về nhà</a>
                            </div>
                        </div><!-- End activity item-->

                    </div>
                </div>
            </div><!-- End Recent Activity -->
            <!-- Upcoming Exams -->
            <div class="card">
                <div class="card-body pb-0">
                    <h5 class="card-title">Bài kiểm tra sắp tới <span>| Tuần này</span></h5>
                    <div class="news">
                        <div class="post-item clearfix">
                            <img src="~/assets/img/news-1.jpg" alt="">
                            <h4><a href="#">Kiểm tra cuối kỳ</a></h4>
                            <p class="small">Môn: Tin học cơ bản<br>Thời gian: 2 giờ</p>
                        </div>

                        <div class="post-item clearfix">
                            <img src="~/assets/img/news-2.jpg" alt="">
                            <h4><a href="#">Bài tập lớn</a></h4>
                            <p class="small">Môn: Lập trình C++<br>Thời gian: 3 giờ</p>
                        </div>

                        <div class="post-item clearfix">
                            <img src="~/assets/img/news-3.jpg" alt="">
                            <h4><a href="#">Thực hành số 3</a></h4>
                            <p class="small">Môn: Cấu trúc dữ liệu<br>Thời gian: 1.5 giờ</p>
                        </div>
                    </div><!-- End sidebar recent posts-->
                </div>
            </div><!-- End Upcoming Exams -->

        </div><!-- End Right side columns -->

    </div>
</section>
