@model TinhocOnline.Models.ViewModels.CreateExamViewModel

@{
    ViewData["Title"] = "Tạo Đề thi Nhanh";
    Layout = "~/Areas/Teacher/Views/Shared/_LayoutTeacher.cshtml";
    var topics = ViewBag.Topics as List<TinhocOnline.Models.Topic>;
}

<div class="pagetitle">
    <h1><i class="bi bi-gear-fill"></i> Tạo Đề thi Nhanh</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Teacher" asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Danh sách Đề thi</a></li>
            <li class="breadcrumb-item active">Tạo Nhanh</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-10">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Tạo cấu trúc đề thi Nhanh</h5>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        <strong>Lưu ý:</strong> Bạn chỉ tạo cấu trúc đề thi (chủ đề, độ khó, thời gian). 
                        Câu hỏi sẽ được sinh tự động khi học sinh vào làm bài.
                    </div>

                    <form asp-action="CreateQuick" method="post" id="createExamForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mt-3" role="alert"></div>
                        <input type="hidden" asp-for="CreateMode" value="quick" />
                        <input type="hidden" asp-for="CreatedBy" />

                        @await Html.PartialAsync("_BasicExamSettings")

                        <hr class="my-3">

                        <!-- Chọn Chủ đề -->
                        <h6><i class="bi bi-collection"></i> Chọn Chủ đề</h6>
                        @if (topics != null)
                        {
                            <div class="row mb-3">
                                <div class="col-sm-12">
                                    @foreach (var topic in topics)
                                    {
                                        <div class="form-check mb-2">
                                            <input type="checkbox" name="SelectedTopicIds" value="@topic.TopicId"
                                                class="form-check-input" id="topic@(topic.TopicId)" checked />
                                            <label class="form-check-label" for="topic@(topic.TopicId)">
                                                @topic.TopicName
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="alert alert-info">
                                <small><i class="bi bi-info-circle"></i> Các chủ đề được chọn sẽ được phân bổ đều số
                                    lượng câu hỏi</small>
                            </div>
                        }

                        <hr class="my-3">

                        <!-- Độ khó -->
                        <h6><i class="bi bi-sliders"></i> Cấu hình độ khó</h6>

                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Dễ (%) <span class="text-danger">*</span></label>
                            <div class="col-sm-9">
                                <input asp-for="EasyPercentage" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="EasyPercentage" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Trung bình (%) <span class="text-danger">*</span></label>
                            <div class="col-sm-9">
                                <input asp-for="MediumPercentage" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="MediumPercentage" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Khó (%) <span class="text-danger">*</span></label>
                            <div class="col-sm-9">
                                <input asp-for="HardPercentage" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="HardPercentage" class="text-danger"></span>
                                <small>Tổng phải bằng 100%</small>
                            </div>
                        </div>

                        <hr class="my-3">

                        <div class="row mb-3">
                            <div class="col-sm-9 offset-sm-3">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-circle me-1"></i> Tạo cấu trúc đề thi
                                </button>
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="bi bi-x-circle me-1"></i> Hủy
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
