@model TinhocOnline.Models.ViewModels.CreateExamViewModel

@{
    ViewData["Title"] = "Sửa Đề thi";
    Layout = "~/Areas/Teacher/Views/Shared/_LayoutTeacher.cshtml";
    var topics = ViewBag.Topics as List<TinhocOnline.Models.Topic>;
    var examId = ViewBag.ExamId as int? ?? 0;
}

<div class="pagetitle">
    <h1><i class="bi bi-pencil-square"></i> Sửa Đề thi</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Teacher" asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Danh sách Đề thi</a></li>
            <li class="breadcrumb-item active">Sửa đề</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-10">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Chỉnh sửa cấu trúc đề thi</h5>

                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Lưu ý:</strong> Bạn chỉ sửa cấu trúc đề thi. Câu hỏi cụ thể sẽ được sinh tự động khi học sinh vào làm bài.
                    </div>

                    <form asp-action="Edit" asp-route-id="@examId" method="post" id="editExamForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mt-3" role="alert"></div>
                        <input type="hidden" asp-for="CreateMode" value="custom" />
                        <input type="hidden" asp-for="CreatedBy" />

                        @await Html.PartialAsync("_BasicExamSettings")

                        <hr class="my-3">

                        <!-- Chọn Chủ đề -->
                        <h6><i class="bi bi-collection"></i> Chọn Chủ đề</h6>
                        @if (topics != null)
                        {
                            <div class="row mb-3">
                                <div class="col-sm-12">
                                    @foreach (var topic in topics)
                                    {
                                        var isChecked = Model.SelectedTopicIds != null && Model.SelectedTopicIds.Contains(topic.TopicId);
                                        <div class="form-check mb-2">
                                            <input type="checkbox" name="SelectedTopicIds" value="@topic.TopicId"
                                                class="form-check-input" id="topic@(topic.TopicId)" @(isChecked ? "checked" : "") />
                                            <label class="form-check-label" for="topic@(topic.TopicId)">
                                                @topic.TopicName
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="alert alert-info">
                                <small><i class="bi bi-info-circle"></i> Các chủ đề được chọn sẽ được phân bổ đều số
                                    lượng câu hỏi</small>
                            </div>
                        }

                        <hr class="my-3">

                        <!-- Độ khó -->
                        <h6><i class="bi bi-sliders"></i> Cấu hình độ khó</h6>

                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Dễ (%) <span class="text-danger">*</span></label>
                            <div class="col-sm-9">
                                <input asp-for="EasyPercentage" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="EasyPercentage" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Trung bình (%) <span class="text-danger">*</span></label>
                            <div class="col-sm-9">
                                <input asp-for="MediumPercentage" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="MediumPercentage" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Khó (%) <span class="text-danger">*</span></label>
                            <div class="col-sm-9">
                                <input asp-for="HardPercentage" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="HardPercentage" class="text-danger"></span>
                                <small>Tổng phải bằng 100%</small>
                            </div>
                        </div>

                        <hr class="my-3">

                        <div class="row mb-3">
                            <div class="col-sm-9 offset-sm-3">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-circle me-1"></i> Lưu thay đổi
                                </button>
                                <a asp-action="Details" asp-route-id="@examId" class="btn btn-secondary">
                                    <i class="bi bi-x-circle me-1"></i> Hủy
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Time picker logic
        document.addEventListener('DOMContentLoaded', function() {
            const startDateInput = document.querySelector('input[name="StartDate"]');
            const endDateInput = document.querySelector('input[name="EndDate"]');
            const durationInput = document.querySelector('input[name="Duration"]');

            if (!startDateInput || !endDateInput || !durationInput) return;

            // Set min datetime to now
            function setMinDateTime() {
                const now = new Date();
                const year = now.getFullYear();
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const day = String(now.getDate()).padStart(2, '0');
                const hours = String(now.getHours()).padStart(2, '0');
                const minutes = String(now.getMinutes()).padStart(2, '0');
                const minDateTime = `${year}-${month}-${day}T${hours}:${minutes}`;
                
                startDateInput.setAttribute('min', minDateTime);
                endDateInput.setAttribute('min', minDateTime);
            }

            // Calculate end date based on start date and duration
            function calculateEndDate() {
                if (!startDateInput.value || !durationInput.value) return;
                
                // Parse datetime-local value
                const startStr = startDateInput.value;
                const duration = parseInt(durationInput.value) || 0;
                
                // Create date from local string
                const startDate = new Date(startStr);
                const endDate = new Date(startDate.getTime() + duration * 60000);
                
                // Format back to datetime-local
                const year = endDate.getFullYear();
                const month = String(endDate.getMonth() + 1).padStart(2, '0');
                const day = String(endDate.getDate()).padStart(2, '0');
                const hours = String(endDate.getHours()).padStart(2, '0');
                const minutes = String(endDate.getMinutes()).padStart(2, '0');
                
                endDateInput.value = `${year}-${month}-${day}T${hours}:${minutes}`;
            }

            // Initialize start date to now if empty
            if (!startDateInput.value) {
                const now = new Date();
                const year = now.getFullYear();
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const day = String(now.getDate()).padStart(2, '0');
                const hours = String(now.getHours()).padStart(2, '0');
                const minutes = String(now.getMinutes()).padStart(2, '0');
                
                startDateInput.value = `${year}-${month}-${day}T${hours}:${minutes}`;
            }

            setMinDateTime();
            calculateEndDate(); // Calculate immediately after setting start date

            // Update end date when duration changes
            durationInput.addEventListener('change', calculateEndDate);
            durationInput.addEventListener('input', calculateEndDate);

            // Update end date when start date changes
            startDateInput.addEventListener('change', calculateEndDate);
        });
    </script>
}
