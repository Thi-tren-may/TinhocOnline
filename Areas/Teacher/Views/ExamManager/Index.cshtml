@model IEnumerable<TinhocOnline.Models.Exam>

@{
    ViewData["Title"] = "Quản lý Đề thi";
    Layout = "~/Areas/Teacher/Views/Shared/_LayoutTeacher.cshtml";
}

<div class="pagetitle">
    <h1>Quản lý Đề thi</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Teacher" asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active">Danh sách Đề thi</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mt-3 mb-3">
                        <h5 class="card-title mb-0">Danh sách Đề thi của tôi</h5>
                    </div>

                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Tên đề thi</th>
                                <th>Loại đề</th>
                                <th>Lớp</th>
                                <th>Số câu</th>
                                <th>Thời gian</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var count = 0;
                            }
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td>@item.ExamName</td>
                                    <td>@item.ExamType?.TypeName</td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.GradeLevel))
                                        {
                                            <span class="badge bg-info">Lớp @item.GradeLevel</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center">@item.TotalQuestions câu</td>
                                    <td class="text-center">@item.Duration phút</td>
                                    <td>
                                        @if (item.Status == "published")
                                        {
                                            <span class="badge bg-success">Đã xuất bản</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Nháp</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.ExamId"
                                                class="btn btn-sm btn-info" title="Xem chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (item.Status == "draft")
                                            {
                                                <form asp-action="Publish" asp-route-id="@item.ExamId" method="post" style="display:inline;">
                                                    <button type="submit" class="btn btn-sm btn-success" title="Xuất bản"
                                                            onclick="return confirm('Xuất bản đề thi này?')">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                </form>
                                            }
                                            <form asp-action="Delete" asp-route-id="@item.ExamId" method="post" style="display:inline;">
                                                <button type="submit" class="btn btn-sm btn-danger" title="Xóa"
                                                        onclick="return confirm('Bạn có chắc muốn xóa đề thi này?')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (!Model.Any())
                    {
                        <div class="alert alert-info text-center">
                            <i class="bi bi-info-circle"></i> Chưa có đề thi nào. Hãy tạo đề thi mới!
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
