@{
    ViewData["Title"] = "Tổng quan - Giáo Viên";
    Layout = "~/Areas/Teacher/Views/Shared/_LayoutTeacher.cshtml";
}

<div class="pagetitle">
    <h1>Tổng quan</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Trang chủ</a></li>
            <li class="breadcrumb-item active">Tổng quan</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<section class="section dashboard">
    <div class="row">

        <!-- Left side columns -->
        <div class="col-lg-8">
            <div class="row">

                <!-- Total Questions Card -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card sales-card">
                        <div class="card-body">
                            <h5 class="card-title">Câu hỏi <span>| Đã tạo</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-question-circle"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@ViewBag.TotalQuestions</h6>
                                    <span class="text-muted small pt-2 ps-1">câu hỏi</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Total Questions Card -->
                
                <!-- Total Exams Card -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card revenue-card">
                        <div class="card-body">
                            <h5 class="card-title">Đề thi <span>| Đã tạo</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-file-earmark-text"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@ViewBag.TotalExams</h6>
                                    <span class="text-muted small pt-2 ps-1">đề thi</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Total Exams Card -->
                
                <!-- Total Students Card -->
                <div class="col-xxl-4 col-xl-12">
                    <div class="card info-card customers-card">
                        <div class="card-body">
                            <h5 class="card-title">Học sinh <span>| Đã làm bài</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-people"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@ViewBag.TotalStudents</h6>
                                    <span class="text-muted small pt-2 ps-1">học sinh</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Total Students Card -->
                
                <!-- Total Attempts Card -->
                <div class="col-xxl-6 col-md-6">
                    <div class="card info-card">
                        <div class="card-body">
                            <h5 class="card-title">Lượt làm bài <span>| Tổng số</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-journal-check"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@ViewBag.TotalAttempts</h6>
                                    <span class="text-muted small pt-2 ps-1">lượt</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Total Attempts Card -->
                <!-- Recent Exams -->
                <div class="col-12">
                    <div class="card recent-sales overflow-auto">
                        <div class="card-body">
                            <h5 class="card-title">Đề thi gần đây <span>| 5 đề mới nhất</span></h5>
                            @if (ViewBag.RecentExams != null && ViewBag.RecentExams.Count > 0)
                            {
                                <table class="table table-borderless">
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Tên đề thi</th>
                                            <th scope="col">Loại</th>
                                            <th scope="col">Thời gian</th>
                                            <th scope="col">Ngày tạo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int index = 1; }
                                        @foreach (var exam in ViewBag.RecentExams)
                                        {
                                            <tr>
                                                <th scope="row">@index</th>
                                                <td>@exam.Title</td>
                                                <td><span class="badge bg-info">@exam.ExamType</span></td>
                                                <td>@exam.Duration phút</td>
                                                <td>@exam.CreatedAt.ToString("dd/MM/yyyy")</td>
                                            </tr>
                                            index++;
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="text-muted">Chưa có đề thi nào được tạo.</p>
                            }
                        </div>
                    </div>
                </div><!-- End Recent Exams -->

            </div>
        </div><!-- End Left side columns -->
        <!-- Right side columns -->
        <div class="col-lg-4">

            <!-- Questions by Topic -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Câu hỏi theo chủ đề <span>| Top 5</span></h5>
                    @if (ViewBag.QuestionsByTopic != null && ViewBag.QuestionsByTopic.Count > 0)
                    {
                        <div class="activity">
                            @foreach (var topic in ViewBag.QuestionsByTopic)
                            {
                                <div class="activity-item d-flex mb-3">
                                    <i class='bi bi-circle-fill activity-badge text-primary align-self-start'></i>
                                    <div class="activity-content w-100">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-bold">@topic.TopicName</span>
                                            <span class="badge bg-primary">@topic.Count câu</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Chưa có câu hỏi nào.</p>
                    }
                </div>
            </div><!-- End Questions by Topic -->
            
            <!-- Quick Actions -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Thao tác nhanh</h5>
                    <div class="d-grid gap-2">
                        <a asp-area="Teacher" asp-controller="QuestionManager" asp-action="Create" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-2"></i>Tạo câu hỏi mới
                        </a>
                        <a asp-area="Teacher" asp-controller="ExamManager" asp-action="Create" class="btn btn-success">
                            <i class="bi bi-file-earmark-plus me-2"></i>Tạo đề thi mới
                        </a>
                        <a asp-area="Teacher" asp-controller="QuestionManager" asp-action="Index" class="btn btn-info">
                            <i class="bi bi-list-ul me-2"></i>Quản lý câu hỏi
                        </a>
                        <a asp-area="Teacher" asp-controller="ExamManager" asp-action="Index" class="btn btn-warning">
                            <i class="bi bi-folder me-2"></i>Quản lý đề thi
                        </a>
                    </div>
                </div>
            </div><!-- End Quick Actions -->

        </div><!-- End Right side columns -->

    </div>
</section>
