@model TinhocOnline.Models.Question

@{
    ViewData["Title"] = "Chỉnh sửa Câu hỏi";
    Layout = "~/Areas/Teacher/Views/Shared/_LayoutTeacher.cshtml";
}

<div class="pagetitle">
    <h1>Chỉnh sửa Câu hỏi</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Teacher" asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Danh sách Câu hỏi</a></li>
            <li class="breadcrumb-item active">Chỉnh sửa</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-10">
            <!-- Thông báo Success/Error -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- FORM 1: Chỉnh sửa Câu hỏi -->
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title">Thông tin Câu hỏi</h5>
                    </div>

                    <form asp-action="Edit" method="post" id="formQuestion">
                        <fieldset id="fieldsetQuestion">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                            <input type="hidden" asp-for="QuestionId" />

                            <div class="row mb-3">
                                <label asp-for="TopicId" class="col-sm-3 col-form-label">Chủ đề <span class="text-danger">*</span></label>
                                <div class="col-sm-9">
                                    <select asp-for="TopicId" class="form-select" asp-items="ViewBag.TopicId">
                                        <option value="">-- Chọn chủ đề --</option>
                                    </select>
                                    <span asp-validation-for="TopicId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label asp-for="QuestionText" class="col-sm-3 col-form-label">Nội dung Câu hỏi <span class="text-danger">*</span></label>
                                <div class="col-sm-9">
                                    <textarea asp-for="QuestionText" class="form-control" rows="4"></textarea>
                                    <span asp-validation-for="QuestionText" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label asp-for="DifficultyLevel" class="col-sm-3 col-form-label">Độ khó <span class="text-danger">*</span></label>
                                <div class="col-sm-9">
                                    <select asp-for="DifficultyLevel" class="form-select">
                                        <option value="">-- Chọn độ khó --</option>
                                        <option value="easy">Dễ</option>
                                        <option value="medium">Trung bình</option>
                                        <option value="hard">Khó</option>
                                    </select>
                                    <span asp-validation-for="DifficultyLevel" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label asp-for="Status" class="col-sm-3 col-form-label">Trạng thái</label>
                                <div class="col-sm-9">
                                    <select asp-for="Status" class="form-select">
                                        <option value="active">Hoạt động</option>
                                        <option value="inactive">Không hoạt động</option>
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-sm-9 offset-sm-3">
                                    <button type="submit" class="btn btn-primary" id="btnSaveQuestion">
                                        <i class="bi bi-check-circle me-1"></i> Lưu thay đổi
                                    </button>
                                    <button type="button" class="btn btn-secondary" id="btnCancelQuestion">
                                        <i class="bi bi-x-circle me-1"></i> Hủy
                                    </button>
                                </div>
                            </div>
                        </fieldset>
                    </form>
                </div>
            </div>

            <!-- FORM 2: Chỉnh sửa Đáp án -->
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title"><i class="bi bi-card-checklist"></i> Danh sách Đáp án</h5>
                    </div>

                    @if (Model.Answers != null && Model.Answers.Any())
                    {
                        <form asp-action="EditAnswer" method="post" id="formAnswers">
                            <fieldset id="fieldsetAnswers">
                                <input type="hidden" name="QuestionId" value="@Model.QuestionId" />

                                @foreach (var answer in Model.Answers.OrderBy(a => a.AnswerOrder))
                                {
                                    <input type="hidden" name="Answers[@answer.AnswerOrder].AnswerId" value="@answer.AnswerId" />
                                    <input type="hidden" name="Answers[@answer.AnswerOrder].QuestionId" value="@answer.QuestionId" />
                                    <input type="hidden" name="Answers[@answer.AnswerOrder].AnswerOrder" value="@answer.AnswerOrder" />

                                    <div class="row mb-3">
                                        <label class="col-sm-2 col-form-label">
                                            <strong>Đáp án @answer.AnswerOrder</strong>
                                        </label>
                                        <div class="col-sm-8">
                                            <input type="text" name="Answers[@answer.AnswerOrder].AnswerText" 
                                                   value="@answer.AnswerText" 
                                                   class="form-control" 
                                                   required />
                                        </div>
                                        <div class="col-sm-2">
                                            <div class="form-check">
                                                <input type="radio" 
                                                       name="CorrectAnswer" 
                                                       value="@answer.AnswerOrder"
                                                       class="form-check-input answer-radio" 
                                                       id="answer@(answer.AnswerOrder)Correct"
                                                       @(answer.IsCorrect ? "checked" : "") />
                                                <label class="form-check-label" for="answer@(answer.AnswerOrder)Correct">
                                                    Đúng
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <input type="hidden" name="Answers[@answer.AnswerOrder].IsCorrect" value="false" class="answer-iscorrect" data-order="@answer.AnswerOrder" />
                                }

                                <div class="alert alert-info" role="alert">
                                    <i class="bi bi-info-circle"></i>Chỉ được chọn 1 đáp án đúng.
                                </div>

                                <div class="row mb-3">
                                    <div class="col-sm-10 offset-sm-2">
                                        <button type="submit" class="btn btn-primary" id="btnSaveAnswers">
                                            <i class="bi bi-check-circle me-1"></i> Lưu đáp án
                                        </button>
                                        <button type="button" class="btn btn-secondary" id="btnCancelAnswers">
                                            <i class="bi bi-x-circle me-1"></i> Hủy
                                        </button>
                                    </div>
                                </div>
                            </fieldset>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> Câu hỏi này chưa có đáp án. Vui lòng thêm đáp án.
                        </div>

                        <form asp-action="EditAnswer" method="post" id="formAddAnswers">
                            <input type="hidden" name="QuestionId" value="@Model.QuestionId" />

                            @for (int i = 0; i < 4; i++)
                            {
                                var answerOrder = ((char)('A' + i)).ToString();
                                <input type="hidden" name="Answers[@answerOrder].QuestionId" value="@Model.QuestionId" />
                                <input type="hidden" name="Answers[@answerOrder].AnswerOrder" value="@answerOrder" />

                                <div class="row mb-3">
                                    <label class="col-sm-2 col-form-label">
                                        <strong>Đáp án @answerOrder</strong>
                                    </label>
                                    <div class="col-sm-8">
                                        <input type="text" name="Answers[@answerOrder].AnswerText" 
                                               class="form-control" 
                                               placeholder="Nhập nội dung đáp án @answerOrder"
                                               required />
                                    </div>
                                    <div class="col-sm-2">
                                        <div class="form-check">
                                            <input type="radio" 
                                                   name="CorrectAnswer" 
                                                   value="@answerOrder"
                                                   class="form-check-input answer-radio-new" 
                                                   id="newAnswer@(answerOrder)Correct" />
                                            <label class="form-check-label" for="newAnswer@(answerOrder)Correct">
                                                Đúng
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <input type="hidden" name="Answers[@answerOrder].IsCorrect" value="false" class="answer-iscorrect-new" data-order="@answerOrder" />
                            }

                            <div class="alert alert-info" role="alert">
                                <i class="bi bi-info-circle"></i> Nhập đầy đủ 4 đáp án (A, B, C, D) và chọn 1 đáp án đúng.
                            </div>

                            <div class="row mb-3">
                                <div class="col-sm-10 offset-sm-2">
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-plus-circle me-1"></i> Thêm đáp án
                                    </button>
                                </div>
                            </div>
                        </form>
                    }
                </div>
            </div>

            <!-- Nút Quay lại -->
            <div class="text-center mb-3">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</section>

