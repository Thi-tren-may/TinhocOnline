@model IEnumerable<TinhocOnline.Models.Question>

@{
    ViewData["Title"] = "Quản lý Câu hỏi";
    Layout = "~/Areas/Teacher/Views/Shared/_LayoutTeacher.cshtml";

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int pageSize = ViewBag.PageSize;
    int stt = (currentPage - 1) * pageSize;
}

<div class="pagetitle">
    <h1>Quản lý Câu hỏi</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Teacher" asp-controller="Dashboard" asp-action="Index">Trang
                    chủ</a></li>
            <li class="breadcrumb-item active">Danh sách Câu hỏi</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mt-3 mb-3">
                        <h5 class="card-title mb-0">Danh sách Câu hỏi</h5>
                        <a asp-action="Create" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-1"></i> Thêm Câu hỏi
                        </a>
                    </div>

                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-header">
                            <tr>
                                <th class="text-center">#</th>
                                <th>Nội dung Câu hỏi</th>
                                <th>Chủ đề</th>
                                <th>Độ khó</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                stt++;
                                <tr>
                                    <td class="text-center">@stt</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.QuestionText))
                                        {
                                            if (item.QuestionText.Length > 100)
                                            {
                                                @item.QuestionText.Substring(0, 100)

                                                <text>...</text>
                                            }
                                            else
                                            {
                                                @item.QuestionText
                                            }
                                        }
                                    </td>
                                    <td>@item.Topic?.TopicName</td>
                                    <td>
                                        @if (item.DifficultyLevel == "easy")
                                        {
                                            <span class="badge bg-success">Dễ</span>
                                        }
                                        else if (item.DifficultyLevel == "medium")
                                        {
                                            <span class="badge bg-warning">Trung bình</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Khó</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.QuestionId"
                                                class="btn btn-sm btn-info" title="Xem chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.QuestionId"
                                                class="btn btn-sm btn-warning" title="Chỉnh sửa">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.QuestionId"
                                                class="btn btn-sm btn-danger" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Pagination -->
                    <nav aria-label="Page navigation" class="d-flex justify-content-center mt-3">
                        <ul class="pagination">
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" href="?page=@i">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>

                </div>
            </div>
        </div>
    </div>
</section>